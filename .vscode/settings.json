{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".mule": true
    },
    "python.defaultInterpreterPath": "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3",
    // Pylance is licensed to Microsoft editors only: inside Cursor it logs its
    // EULA and then never serves, which silently costs you completions. Pointing
    // ms-python at no language server stops it launching that dead process;
    // anysphere.cursorpyright supplies IntelliSense instead, and reads its own
    // cursorpyright.* keys rather than the python.analysis.* ones below.
    "python.languageServer": "None",
    "cursorpyright.analysis.extraPaths": [
        "python/src"
    ],
    "cursorpyright.analysis.typeCheckingMode": "basic",
    "cursorpyright.analysis.autoImportCompletions": true,
    // Kept so the same checkout still resolves agent_fabric under Pylance in VS Code.
    "python.analysis.extraPaths": [
        "python/src"
    ],
    "python.analysis.typeCheckingMode": "basic"
}
